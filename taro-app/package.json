{
  "name": "rental-taro-app",
  "version": "0.1.0",
  "private": true,
  "description": "JoyRent · 用户端（微信 / 支付宝小程序）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "React"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp && node scripts/check-dist.mjs weapp",
    "build:alipay": "taro build --type alipay && node scripts/check-dist.mjs alipay",
    "check:dist": "node scripts/check-dist.mjs",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "^3.0.18",
    "@tanstack/react-query": "^5.100.14",
    "@tarojs/components": "4.1.2",
    "@tarojs/helper": "4.1.2",
    "@tarojs/plugin-framework-react": "4.1.2",
    "@tarojs/plugin-platform-alipay": "4.1.2",
    "@tarojs/plugin-platform-weapp": "4.1.2",
    "@tarojs/react": "4.1.2",
    "@tarojs/runtime": "4.1.2",
    "@tarojs/shared": "4.1.2",
    "@tarojs/taro": "4.1.2",
    "dayjs": "^1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.1.2",
    "@tarojs/webpack5-runner": "4.1.2",
    "@types/react": "^18.2.43",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.1.2",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.1.2",
    "sass": "^1.77.0",
    "typescript": "^5.5.4"
  }
}
