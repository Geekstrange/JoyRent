# Taro 环境变量（所有模式的公共兜底）
#
# 加载顺序（后者覆盖前者）：
#   .env  <  .env.local  <  .env.<mode>  <  .env.<mode>.local
# 其中 mode = NODE_ENV：`taro build` 为 production，`taro build --watch` 为 development。
#
# ⚠️ 为什么必须存在：Taro 只对**已定义**的 process.env.TARO_APP_* 做构建期替换。
# 未定义的变量会把 `process.env.XXX` 原样留在产物里，而小程序没有 process 全局，
# 启动即抛 `ReferenceError: process is not defined` → app.js 崩溃 → 白屏。
# 因此源码用到的每个 TARO_APP_* 都必须在某个 env 文件里有值（可为空串）。
#
# ⚠️ 注意：`npm run build:weapp`(taro build) 会把 NODE_ENV 置为 production，
# 所以真正生效的是 .env.production —— 改地址请改那个文件，不要只改这里。

# 后端 API 前缀
TARO_APP_API_BASE=http://127.0.0.1:8080/api/v1

# 静态资源前缀（后端 storage.base_url = "/static"）
TARO_APP_ASSET_BASE=http://127.0.0.1:8080/static

# 测试态登录旁路开关（后端 /app/auth/dev-login）。
# 本地无小程序密钥时，正式登录（模拟 code 换不到 openid）必然失败，
# 开启后前端会自动回落到旁路，保证本地能完整跑通登录链路。
# ⚠️ 发布到线上前必须在 .env.production 里改成 false。
TARO_APP_DEV_LOGIN=true
